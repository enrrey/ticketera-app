# Completar en .env con credenciales de desarrollo/prueba.
# Clerk: Dashboard > API keys (pk_test_... y sk_test_...).
# Google se habilita como conexion social en Clerk; sus credenciales van en Clerk.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret del endpoint de webhooks de Clerk.
CLERK_WEBHOOK_SIGNING_SECRET=
# URL de retorno de invitaciones de personal; Clerk autentica y vuelve a /.
APP_URL=http://localhost:3000

# Stripe: claves de prueba (pk_test_... y sk_test_...).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Signing secret del endpoint o de stripe listen (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Secreto independiente para POST /api/internal/payment-jobs (scheduler cada minuto).
PAYMENT_JOBS_SECRET=

# Neon: copiar la URL PostgreSQL desde Connect, conservando parametros TLS.
# URL con pooling para la aplicacion.
DATABASE_URL=
# URL directa, opcional segun la herramienta de migraciones que se elija.
DATABASE_URL_UNPOOLED=
# Private, stable 32-byte hexadecimal key. Preserve it to reconstruct issued QR credentials.
QR_SIGNING_SECRET=

# Resend: dominio/remitente verificado; sin estas variables los correos quedan pendientes.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
